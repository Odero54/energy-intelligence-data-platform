# Never commit .env to version control

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_SUPERSET_DB=superset

# ─── Airflow ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=changeme_webserver_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ─── Superset ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=changeme_superset_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# ─── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=               # e.g. abc12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ENERGY_INTELLIGENCE
SNOWFLAKE_WAREHOUSE=ENERGY_WH
SNOWFLAKE_ROLE=ENERGY_ROLE

# ─── Google Earth Engine ──────────────────────────────────────────────────────
# Service account key file path (relative to project root)
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=secrets/gee-service-account.json

# ─── World Bank API ───────────────────────────────────────────────────────────
# No key required — public API
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2

# ─── General ──────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
